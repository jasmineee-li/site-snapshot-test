# Required API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Claude Code subscription auth (alternative to ANTHROPIC_API_KEY for app generation)
# Run `claude setup-token` to generate a long-lived OAuth token (valid ~1 year).
# When set, app generation uses your Max/Pro subscription instead of per-token API billing.
# Note: ANTHROPIC_API_KEY is automatically suppressed for Claude Code when this is set,
# because Claude Code's auth precedence puts API keys above OAuth tokens.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Optional: Direct provider access (if not using OpenRouter)
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# VLLM_API_KEY=

# Optional: HuggingFace / custom model endpoints
# AGENTLAB_MODEL_TOKEN=
# AGENTLAB_MODEL_URL=

# Optional: Agent Xray UI
# AGENTXRAY_SHARE_GRADIO=false
# AGENTXRAY_APP_PORT=7860

# Optional: Debug
# AGENTLAB_DEBUG=1
