# WorldSim v5 environment variables
# Copy to .env and fill in.

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Anthropic API key — used by Browser Use (evaluation agent LLM in Phases 3–4)
# and as a local fallback for Claude Code when the Modal secret isn't available.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modal authentication. Easiest path: `modal token new`, which writes
# ~/.modal.toml. For CI/containers, set these env vars instead.
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...

# -----------------------------------------------------------------------------
# MODAL SECRETS
# -----------------------------------------------------------------------------
# Claude Code running INSIDE the Modal sandbox reads its API key from a Modal
# secret. The default secret name is "anthropic-secret"; create it with:
#
#   modal secret create anthropic-secret ANTHROPIC_API_KEY=sk-ant-...
#
# If you already have a secret with a different name, set this override.
# WORLDSIM_CLAUDE_MODAL_SECRET=anthropic-secret

# -----------------------------------------------------------------------------
# BROWSER USE — evaluation agent LLM (Phases 3 and 4)
# -----------------------------------------------------------------------------
# Browser Use uses the Anthropic SDK by default (ANTHROPIC_API_KEY above).
# If you prefer OpenRouter or OpenAI for the eval LLM, set these instead.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# WEBARENA BENCHMARK INSTANCES (Phases 3 and 4)
# -----------------------------------------------------------------------------
# The user stands up WebArena instances per the v5 spec "Prerequisites" section
# and supplies them to the orchestrator via worldsim/main.py configuration.
# These placeholders are just a convenience for editing main.py.
# WORLDSIM_WEBARENA_SHOPPING_URL=http://localhost:7770
# WORLDSIM_WEBARENA_SHOPPING_DB=mysql://user:pass@localhost:3306/opencart
# WORLDSIM_WEBARENA_SHOPPING_RESET=http://localhost:7770/reset

# -----------------------------------------------------------------------------
# OPTIONAL
# -----------------------------------------------------------------------------
# Override where pipeline state and artifacts are written (default: ./logs/).
# WORLDSIM_STATE_DIR=logs
