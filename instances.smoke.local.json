{
  "benchmark_name": "WebArena Verified",
  "benchmark_codebase": "vendors/webarena-verified",
  "verification_proxy": {
    "token_env": "WORLDSIM_VERIFICATION_PROXY_TOKEN",
    "token_file": ".proxy_token",
    "port_offset": 10000
  },
  "url_placeholders": {
    "__GITLAB__": "http://127.0.0.1:8023",
    "__REDDIT__": "http://127.0.0.1:9999"
  },
  "instances": [
    {
      "benchmark_name": "WebArena Verified",
      "site_name": "gitlab",
      "site_url": "http://127.0.0.1:8023",
      "reset_endpoint": "http://127.0.0.1:8024/init",
      "db_connection": "postgresql://gitlab@127.0.0.1:5433/gitlabhq_production",
      "auth": {
        "type": "bearer_token",
        "header_name": "PRIVATE-TOKEN",
        "token_generator": "gitlab_pat",
        "credentials": {
          "username": "byteblaze",
          "password": "hello1234"
        }
      },
      "agent_auth": {
        "type": "storage_state",
        "storage_state": {
          "path": "logs/phase_0d/gitlab/storage_state.json",
          "form_login": {
            "login_url": "/users/sign_in",
            "username_selector": "input[name='user[login]']",
            "password_selector": "input[name='user[password]']",
            "submit_selector": "button[data-testid='sign-in-button']",
            "success_url_substring": "/"
          }
        },
        "authentication": {
          "credentials": {
            "username": "byteblaze",
            "password": "hello1234"
          }
        }
      }
    },
    {
      "benchmark_name": "WebArena Verified",
      "site_name": "reddit",
      "site_url": "http://127.0.0.1:9999",
      "reset_endpoint": "http://127.0.0.1:9998/init",
      "db_connection": "postgresql://postmill:postmill@127.0.0.1:5434/postmill",
      "auth": {
        "type": "http_headers",
        "headers": {
          "X-Postmill-Auto-Login": {
            "from_env": "WORLDSIM_REDDIT_AUTO_LOGIN"
          }
        }
      },
      "agent_auth": {
        "type": "http_headers",
        "http_headers": {
          "headers": {
            "X-Postmill-Auto-Login": "${credentials.username}:${credentials.password}"
          }
        },
        "authentication": {
          "credentials": {
            "username": "MarvelsGrantMan136",
            "password": "test1234"
          }
        }
      }
    }
  ]
}
